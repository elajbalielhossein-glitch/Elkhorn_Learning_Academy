   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A male construction worker talks with a fellow female co-worker on site as he  checks in on the completion of tasks.  The two are dressed in workwear and proper safety gear as they plan out the tasks to be completed and work together.</rdf:li>
    </rdf:Alt>
   </dc:description>
